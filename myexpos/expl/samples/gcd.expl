
int main(){
    decl
        int a,b,out,temp;
    enddecl

    begin
        temp=exposcall("Read",-1,a);
        temp=exposcall("Read",-1,b);
        if(a<b) then
            temp=a;
            a=b;
            b=temp;
        endif;

        while(b!=0) do
            temp=a%b;
            a=b;
            b=temp;
        endwhile;

        temp=exposcall("Write",-2,a);

        return 0;

    end
}