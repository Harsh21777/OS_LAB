int main(){
    decl
        int temp, fileDesc, a, i, permission;
        str word, fileName;
    enddecl
    begin
        temp = exposcall("Write", -2, "FILENAME:");
        temp = exposcall("Read", -1, fileName);
        fileDesc = exposcall("Open", fileName);
        if(fileDesc == -1) then
            temp = exposcall("Write", -2, "File not found");
        else
            if(fileDesc == -2) then
                temp = exposcall("Write", -2, "System max file opened");
            else
                if(fileDesc == -3) then
                    temp = exposcall("Write", -2, "Proc max file opened");
                endif;
            endif;
        endif;

        if(fileDesc >= 0) then
            i = 1;
            while(i <=1) do
                temp = exposcall("Read",-1,word);
                temp = exposcall("Write", fileDesc, word);
                i = i + 1;
            endwhile;

            
        endif;
        temp = exposcall("Close", fileDesc);

        return 0;
    end
}