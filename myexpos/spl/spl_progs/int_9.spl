//incr no. switches to KERNEL
[32227]=[32227]+1;

//saving userStack and setting kernelStack
alias userSP R0;
userSP=SP;

[PROCESS_TABLE+[SYSTEM_STATUS_TABLE+1]*16+13]=SP;

SP=[PROCESS_TABLE+[SYSTEM_STATUS_TABLE+1]*16+11]*512-1;

//set MODE flag
[PROCESS_TABLE+[SYSTEM_STATUS_TABLE+1]*16+9]=INT_EXEC;

alias fileName R1;
alias pageNum R2;
alias offset R3;
alias pageTable R4;

pageTable=PAGE_TABLE_BASE+[SYSTEM_STATUS_TABLE+1]*20;

pageNum=[pageTable+2*((userSP-4)/512)];
offset=(userSP-4)%512;
fileName=[(pageNum*512)+offset];

alias inodeIdx R5;
inodeIdx=0;
alias present R6;
present=0;
while(inodeIdx<MAX_FILE_NUM) do
    if([INODE_TABLE+inodeIdx*16+1]==fileName) then
        if([INODE_TABLE+inodeIdx*16+0]!=EXEC) then
            break;
        endif;
        present=1;
        break;
    endif;
    inodeIdx=inodeIdx+1;

endwhile;

if(!present) then
    pageNum=[PTBR+2*((userSP-1)/512)];
    offset=(userSP-1)%512;
    [(pageNum*512)+offset]=-1;
    [PROCESS_TABLE + [SYSTEM_STATUS_TABLE + 1] * 16 + 9] = 0;
    SP = userSP;
    ireturn;
endif;

multipush(R0,R1,R2,R3,R4,R5,R6);

alias funcNum R1;
alias pid R2;
funcNum=EXIT_PROCESS;
pid=[SYSTEM_STATUS_TABLE+1];

call MOD_1;

multipop(R0,R1,R2,R3,R4,R5,R6);

alias userAreaPageNum R7;
userAreaPageNum=[PROCESS_TABLE+[SYSTEM_STATUS_TABLE+1]*16+11];


[MEMORY_FREE_LIST+userAreaPageNum]=[MEMORY_FREE_LIST+userAreaPageNum]+1;
[SYSTEM_STATUS_TABLE+2]=[SYSTEM_STATUS_TABLE+2]-1;

SP=userAreaPageNum*512;

[PROCESS_TABLE+[SYSTEM_STATUS_TABLE+1]*16+4]=RUNNING;
[PROCESS_TABLE+[SYSTEM_STATUS_TABLE+1]*16+7]=inodeIdx;

[PTBR]=63;
[PTBR+1]="0100";

[PTBR+2]=64;
[PTBR+3]="0100";

[PTBR+4]=-1;
[PTBR+5]="0000";

[PTBR+6]=-1;
[PTBR+7]="0000";

//getting free pages and allocating in page table for stack n heap 
multipush(R0,R1,R2,R3,R4,R5,R6,R7);

alias freePageNum R0;

R1=GET_FREE_PAGE;
call MOD_2;
[PTBR+16]=R0;
[PTBR+17]="0110";

R1=GET_FREE_PAGE;
call MOD_2;
[PTBR+18]=R0;
[PTBR+19]="0110";

multipop(R0,R1,R2,R3,R4,R5,R6,R7);

breakpoint;

if([INODE_TABLE+inodeIdx*16+8]!=-1) then
    multipush(R0,R1,R2,R3,R4,R5,R6,R7);
    //get code page
    R1=GET_CODE_PAGE;
    R2=[INODE_TABLE+inodeIdx*16+8];
    call MOD_2;
    [PTBR+8]=R0;
    [PTBR+9]="0100";
    multipop(R0,R1,R2,R3,R4,R5,R6,R7);
endif;

breakpoint;

[PTBR+10]=-1;
[PTBR+11]="0000";

[PTBR+12]=-1;
[PTBR+13]="0000";

[PTBR+14]=-1;
[PTBR+15]="0000";

//initialise disk map table
alias diskMapEntry R8;
alias iter R9;

diskMapEntry=DISK_MAP_TABLE+[SYSTEM_STATUS_TABLE+1]*10;
iter=0;
while(iter<10) do
    [diskMapEntry+iter]=-1;
    iter=iter+1;
endwhile;
//initialise code disk blocks to diskmaptable
[diskMapEntry+4]=[INODE_TABLE+inodeIdx*16+8];
[diskMapEntry+5]=[INODE_TABLE+inodeIdx*16+9];
[diskMapEntry+6]=[INODE_TABLE+inodeIdx*16+10];
[diskMapEntry+7]=[INODE_TABLE+inodeIdx*16+11];


//per-process resource table
userAreaPageNum=[PROCESS_TABLE+[SYSTEM_STATUS_TABLE+1]*16+11];
alias perProcessResourceEntry R8;
perProcessResourceEntry=userAreaPageNum*512+496;

iter=0;

while(iter<16) do
    [perProcessResourceEntry+iter]=-1;
    iter=iter+2;
endwhile;


[[PTBR+16]*512]=[([PTBR+8]*512)+1];
SP=8*512;

[PROCESS_TABLE+[SYSTEM_STATUS_TABLE+1]*16+9]=0;

breakpoint;
ireturn;