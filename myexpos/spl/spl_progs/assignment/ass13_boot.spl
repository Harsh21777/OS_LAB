//load INT7 from disk to mem
loadi(16,29);
loadi(17,30);

//loading timer interrupt routine 
loadi(4,17);
loadi(5,18);

// load library code
loadi(63,13);
loadi(64,14);

// loading INIT program from disk 7-8 to mem 65-66
loadi(65,7);
loadi(66,8);

//loading ODD program from disk tp next available page
loadi(87,69);

// loading INT 10 code from disk 35-36 to mem 22-23
loadi(22,35);
loadi(23,36);

// loading ExHanding code from disk 15-16 to mem 2-3
loadi(2,15);
loadi(3,16);

//FOR EVEN PROCESS

// initializing PTBR to default - 29696+20(as pid of init=1)
PTBR = PAGE_TABLE_BASE+20;

// INIT Program needs 3 pages of memory
PTLR = 10;

// library
[PTBR+0] =  63;
[PTBR+1] = "0100";	
[PTBR+2] = 64;
[PTBR+3] = "0100";

//heap
[PTBR+4] = 78;
[PTBR+5] = "0110";	
[PTBR+6] = 79;
[PTBR+7] = "0110";	

//code
[PTBR+8] = 65;
[PTBR+9] = "0100";	
[PTBR+10] = 66;
[PTBR+11] = "0100";	
[PTBR+12] = -1;
[PTBR+13] = "0000";	
[PTBR+14] = -1;
[PTBR+15] = "0000";	

//stack
[PTBR+16] = 76;
[PTBR+17] = "0110";	
[PTBR+18] = 77;
[PTBR+19] = "0110";	

[76*512] = [65*512+1];	// IP to 2nd word in header when loaded from code which is in EXEC format


//user Area page for init process
[PROCESS_TABLE +1*16+ 11] = 80;
//setting PID for 1st process 
[PROCESS_TABLE+1*16+1]=1;
//setinng state
[PROCESS_TABLE+1*16+4]=CREATED;
//seting UPTR field 
[PROCESS_TABLE +1*16+ 13] = 8*512;
//seting KPTR field 
[PROCESS_TABLE +1*16+ 12] = 0;
//seting PTBR and PTLR field 
[PROCESS_TABLE +1*16+ 14] = PAGE_TABLE_BASE+20;
[PROCESS_TABLE +1*16+ 15] = 10;


//FOR ODD PROCESS

// initializing PTBR to default - 29696+20(as pid of init=1)
PTBR = PAGE_TABLE_BASE+40;

// INIT Program needs 3 pages of memory
PTLR = 10;

// library
[PTBR+0] =  63;
[PTBR+1] = "0100";	
[PTBR+2] = 64;
[PTBR+3] = "0100";

//heap
[PTBR+4] = 83;
[PTBR+5] = "0110";	
[PTBR+6] = 84;
[PTBR+7] = "0110";	

//code
[PTBR+8] = 87;
[PTBR+9] = "0100";	
[PTBR+10] = -1;
[PTBR+11] = "0000";	
[PTBR+12] = -1;
[PTBR+13] = "0000";	
[PTBR+14] = -1;
[PTBR+15] = "0000";	

//stack
[PTBR+16] = 85;
[PTBR+17] = "0110";	
[PTBR+18] = 86;
[PTBR+19] = "0110";	

[85*512] = [87*512+1];	// IP to 2nd word in header when loaded from code which is in EXEC format


//user Area page for init process
[PROCESS_TABLE +2*16+ 11] = 88;
//setting PID for 1st process 
[PROCESS_TABLE+2*16+1]=2;
//setinng state
[PROCESS_TABLE+2*16+4]=CREATED;
//seting UPTR field 
[PROCESS_TABLE +2*16+ 13] = 8*512;
//seting KPTR field 
[PROCESS_TABLE +2*16+ 12] = 0;
//seting PTBR and PTLR field 
[PROCESS_TABLE +2*16+ 14] = PAGE_TABLE_BASE+40;
[PROCESS_TABLE +2*16+ 15] = 10;



return;