//Obtain the PID of the current process from the System Status Table.
breakpoint;
alias currentPID R1;
currentPID=[SYSTEM_STATUS_TABLE +1];

//Obtain the Process Table entry corresponding to the current PID.
alias process_table_entry R2;
process_table_entry=PROCESS_TABLE+currentPID*16;
[process_table_entry+4]=TERMINATED;

alias iterPID R3;
alias flg R4;
iterPID=1;
flg=0;

while(iterPID<MAX_PROC_NUM) do
    if([PROCESS_TABLE+iterPID*16+4]!=TERMINATED) then 
        flg=1;
        call MOD_5;
    endif;
    iterPID=iterPID+1;
endwhile;

breakpoint;
halt;
