alias retVal R0;
alias funcNum R1;
alias currentPID R2;

breakpoint;
if(funcNum==8) then 

    while([TERMINAL_STATUS_TABLE]!=0) do
        [PROCESS_TABLE+currentPID*16+4]=WAIT_TERMINAL;
        multipush(R1,R2);
        
        call MOD_5;

        multipop(R1,R2);

    endwhile;

    [TERMINAL_STATUS_TABLE]=1;
    [TERMINAL_STATUS_TABLE+1]=currentPID;

    return;
endif;

breakpoint;
if(funcNum==9) then 
    if(currentPID!=[TERMINAL_STATUS_TABLE+1]) then
        retVal=-1;
        return;
    endif;
    [TERMINAL_STATUS_TABLE]=0;

    alias iterPID R5;
    iterPID=0;

    while(iterPID<16) do
        if([PROCESS_TABLE+iterPID*16+4]==WAIT_TERMINAL) then
            [PROCESS_TABLE+iterPID*16+4]=READY;
        endif;
        iterPID=iterPID+1;
    endwhile;

    retVal=0;
    return;
endif;

retVal=-1;
return;



