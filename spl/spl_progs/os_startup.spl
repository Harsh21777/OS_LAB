//load module 7 (boot module)from disk
loadi(54,67);
loadi(55,68);

// scheduler(module 5)
loadi(50, 63);
loadi(51, 64);

//Load only the first code page from disk to memory
loadi(69,11);
//loadi(70,12);

//set stack pointer to userAreaPage
SP = 76*512-1;
call BOOT_MODULE;


//FOR SWAPPER_DAEMON PROCESS

PTBR=PAGE_TABLE_BASE+SWAPPER_DAEMON*20;
PTLR=10;

// library
[PTBR+0] =  -1;
[PTBR+1] = "0000";	
[PTBR+2] = -1;
[PTBR+3] = "0000";

//heap
[PTBR+4] = -1;
[PTBR+5] = "0000";	
[PTBR+6] = -1;
[PTBR+7] = "0000";	

//code
[PTBR+8] = 69;
[PTBR+9] = "0100";	
[PTBR+10] = -1;
[PTBR+11] = "0000";	
[PTBR+12] = -1;
[PTBR+13] = "0000";	
[PTBR+14] = -1;
[PTBR+15] = "0000";	

//stack
[PTBR+16] = 81; 
[PTBR+17] = "0110";	
[PTBR+18] = -1;
[PTBR+19] = "0000";	

[81*512]=[69*512+1];

alias swap_table R1;
swap_table=PROCESS_TABLE+SWAPPER_DAEMON*16;
[swap_table+0]=0;
[swap_table+3]=0;
//setting PID for 15st process 
[swap_table+1]=SWAPPER_DAEMON;
//setinng state
[swap_table+4]=CREATED;
//user Area page for swapper process
[swap_table + 11] = 82;
//seting UPTR field 
[swap_table + 13] = 8*512;
//seting KPTR field 
[swap_table + 12] = 0;
//seting PTBR and PTLR field 
[swap_table + 14] = PTBR;
[swap_table + 15] = PTLR;


//FOR IDLE PROCESS

PTBR=PAGE_TABLE_BASE;
PTLR=10;

// library
[PTBR+0] =  -1;
[PTBR+1] = "0000";	
[PTBR+2] = -1;
[PTBR+3] = "0000";

//heap
[PTBR+4] = -1;
[PTBR+5] = "0000";	
[PTBR+6] = -1;
[PTBR+7] = "0000";	

//code
[PTBR+8] = 69;
[PTBR+9] = "0100";	
[PTBR+10] = -1;
[PTBR+11] = "0000";	
[PTBR+12] = -1;
[PTBR+13] = "0000";	
[PTBR+14] = -1;
[PTBR+15] = "0000";	

//stack
[PTBR+16] = 70; //Allocate second code page (70) as user stack page for idle
[PTBR+17] = "0110";	
[PTBR+18] = -1;
[PTBR+19] = "0000";	

[70*512]=[69*512+1];


[PROCESS_TABLE+0]=0;
[PROCESS_TABLE+3]=0;
//setting PID for 0st process 
[PROCESS_TABLE+1]=IDLE_PROCESS;
//setinng state
[PROCESS_TABLE+4]=RUNNING;
//user Area page for idle process
[PROCESS_TABLE + 11] = 76;
//seting UPTR field 
[PROCESS_TABLE + 13] = 8*512;
//seting KPTR field 
[PROCESS_TABLE + 12] = 0;
//seting PTBR and PTLR field 
[PROCESS_TABLE + 14] = PAGE_TABLE_BASE;
[PROCESS_TABLE + 15] = 10;

SP=8*512;
//setting current going PID in status table
[SYSTEM_STATUS_TABLE +1]=IDLE_PROCESS;

ireturn;