//load idle code from disk
loadi(69,11);
loadi(70,12);

//load INT7 from disk to mem
loadi(16,29);
loadi(17,30);

//loading timer interrupt routine 
loadi(4,17);
loadi(5,18);

// load library code
loadi(63,13);
loadi(64,14);

// loading INIT program from disk 7-8 to mem 65-66
loadi(65,7);
loadi(66,8);

// loading INT 10 code from disk 35-36 to mem 22-23
loadi(22,35);
loadi(23,36);

// loading ExHanding code from disk 15-16 to mem 2-3
loadi(2,15);
loadi(3,16);

//FOR IDLE PROCESS

PTBR=PAGE_TABLE_BASE;
PTLR=10;

// library
[PTBR+0] =  63;
[PTBR+1] = "0100";	
[PTBR+2] = 64;
[PTBR+3] = "0100";

//heap
[PTBR+4] = -1;
[PTBR+5] = "0000";	
[PTBR+6] = -1;
[PTBR+7] = "0000";	

//code
[PTBR+8] = 69;
[PTBR+9] = "0100";	
[PTBR+10] = 70;
[PTBR+11] = "0100";	
[PTBR+12] = -1;
[PTBR+13] = "0000";	
[PTBR+14] = -1;
[PTBR+15] = "0000";	

//stack
[PTBR+16] = 81;
[PTBR+17] = "0110";	
[PTBR+18] = -1;
[PTBR+19] = "0000";	

[81*512]=[69*512+1];


//setting PID for 0st process 
[PROCESS_TABLE+1]=0;
//setinng state
[PROCESS_TABLE+4]=CREATED;
//user Area page for idle process
[PROCESS_TABLE + 11] = 82;
//seting UPTR field 
[PROCESS_TABLE + 13] = 8*512;
//seting KPTR field 
[PROCESS_TABLE + 12] = 0;
//seting PTBR and PTLR field 
[PROCESS_TABLE + 14] = PAGE_TABLE_BASE;
[PROCESS_TABLE + 15] = 10;


breakpoint;
//FOR INIT PROCESS

// initializing PTBR to default - 29696+20(as pid of init=1)
PTBR = PAGE_TABLE_BASE+20;

// INIT Program needs 3 pages of memory
PTLR = 10;

// library
[PTBR+0] =  63;
[PTBR+1] = "0100";	
[PTBR+2] = 64;
[PTBR+3] = "0100";

//heap
[PTBR+4] = 78;
[PTBR+5] = "0110";	
[PTBR+6] = 79;
[PTBR+7] = "0110";	

//code
[PTBR+8] = 65;
[PTBR+9] = "0100";	
[PTBR+10] = 66;
[PTBR+11] = "0100";	
[PTBR+12] = -1;
[PTBR+13] = "0000";	
[PTBR+14] = -1;
[PTBR+15] = "0000";	

//stack
[PTBR+16] = 76;
[PTBR+17] = "0110";	
[PTBR+18] = 77;
[PTBR+19] = "0110";	

[76*512] = [65*512+1];	// IP to 2nd word in header when loaded from code which is in EXEC format


//user Area page for init process
[PROCESS_TABLE +1*16+ 11] = 80;
//setting PID for 1st process 
[PROCESS_TABLE+1*16+1]=1;
//setinng state
[PROCESS_TABLE+1*16+4]=RUNNING;
//seting UPTR field 
[PROCESS_TABLE +1*16+ 13] = 8*512;
//seting KPTR field 
[PROCESS_TABLE +1*16+ 12] = 0;
//seting PTBR and PTLR field 
[PROCESS_TABLE +1*16+ 14] = PAGE_TABLE_BASE+20;
[PROCESS_TABLE +1*16+ 15] = 10;

breakpoint;
SP = 8*512;
//setting current going PID in status table
[SYSTEM_STATUS_TABLE +1]=1;


breakpoint;
ireturn;