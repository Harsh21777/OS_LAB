//incr no. switches to KERNEL
[32227]=[32227]+1;

//saving userStack and setting kernelStack
alias userSP R1;
userSP=SP;

[PROCESS_TABLE+[SYSTEM_STATUS_TABLE+1]*16+13]=SP;
SP=[PROCESS_TABLE+[SYSTEM_STATUS_TABLE+1]*16+11]*512-1;

alias sysCallNo R2;
sysCallNo=[([PTBR + 2*((userSP-5)/512)]*512)+((userSP-5)%512)];

//semLock
if(sysCallNo==INT_SEMLOCK) then
    //change MODE flg
    [PROCESS_TABLE+[SYSTEM_STATUS_TABLE+1]*16+9]=INT_SEMLOCK;

    alias semId R3;
    semId=[([PTBR + 2*((userSP-4)/512)]*512)+((userSP-4)%512)];

    alias perProcResourceEntry R4;
    perProcResourceEntry=[PROCESS_TABLE+[SYSTEM_STATUS_TABLE+1]*16+11]*512+496;

    //semaphore descriptor invalid
    if((semId<0)||(semId>7)||([perProcResourceEntry+(semId*2)]!=1)) then
        [([PTBR + 2*((userSP-1)/512)]*512)+((userSP-1)%512)]=-1;
        [PROCESS_TABLE+[SYSTEM_STATUS_TABLE+1]*16+9]=0;
        SP=userSP;

        ireturn;
    endif;

    alias semTableIdx R5;
    semTableIdx=[perProcResourceEntry+(semId*2)+1];

    while(([SEMAPHORE_TABLE+(semTableIdx*4)]!=-1)&&[SEMAPHORE_TABLE+(semTableIdx*4)]!=[SYSTEM_STATUS_TABLE+1]) do
        [PROCESS_TABLE+([SYSTEM_STATUS_TABLE+1]*16)+4]=WAIT_SEMAPHORE;
        [PROCESS_TABLE+([SYSTEM_STATUS_TABLE+1]*16)+5]=semTableIdx;

        multipush(R1,R2,R3,R4,R5);

        call MOD_5;//scheduler 

        multipop(R1,R2,R3,R4,R5);
       
    endwhile;

    [SEMAPHORE_TABLE+(semTableIdx*4)]=[SYSTEM_STATUS_TABLE+1];

    [([PTBR + 2*((userSP-1)/512)]*512)+((userSP-1)%512)]=0;//success
    [PROCESS_TABLE+[SYSTEM_STATUS_TABLE+1]*16+9]=0;
    SP=userSP;

    ireturn;
endif;

//semUnlock
if(sysCallNo==INT_SEMUNLOCK) then 
    //change MODE flg
    [PROCESS_TABLE+[SYSTEM_STATUS_TABLE+1]*16+9]=INT_SEMUNLOCK;

    alias semId R3;
    semId=[([PTBR + 2*((userSP-4)/512)]*512)+((userSP-4)%512)];

    alias perProcResourceEntry R4;
    perProcResourceEntry=[PROCESS_TABLE+[SYSTEM_STATUS_TABLE+1]*16+11]*512+496;

    //semaphore descriptor invalid
    if((semId<0)||(semId>7)||([perProcResourceEntry+(semId*2)]!=1)) then
        [([PTBR + 2*((userSP-1)/512)]*512)+((userSP-1)%512)]=-1;
        [PROCESS_TABLE+[SYSTEM_STATUS_TABLE+1]*16+9]=0;
        SP=userSP;

        ireturn;
    endif;

    alias semTableIdx R5;
    semTableIdx=[perProcResourceEntry+(semId*2)+1];

    if([SEMAPHORE_TABLE+(semTableIdx*4)]!=-1) then
        //not locked by current process
        if([SEMAPHORE_TABLE+(semTableIdx*4)]!=[SYSTEM_STATUS_TABLE+1]) then
            [([PTBR + 2*((userSP-1)/512)]*512)+((userSP-1)%512)]=-2;
            [PROCESS_TABLE+[SYSTEM_STATUS_TABLE+1]*16+9]=0;
            SP=userSP;

            ireturn;
        endif;

        [SEMAPHORE_TABLE+(semTableIdx*4)]=-1;

        alias iter R6;
        iter=0;
        while(iter<16) do
            if(([PROCESS_TABLE+(iter*16)+4]==WAIT_SEMAPHORE)&&([PROCESS_TABLE+(iter*16)+5]==semTableIdx)) then
                [PROCESS_TABLE+(iter*16)+4]=READY;
            endif;
            iter=iter+1;
        endwhile;
    endif;

    [([PTBR + 2*((userSP-1)/512)]*512)+((userSP-1)%512)]=0;//success
    [PROCESS_TABLE+[SYSTEM_STATUS_TABLE+1]*16+9]=0;
    SP=userSP;

    ireturn;


endif;