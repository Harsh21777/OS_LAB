alias funcNum R1;

//free userAreaPage
if(funcNum==2) then
    alias pid R2;
    multipush(R1,R2);
    R1=2;
    R2=[PROCESS_TABLE+pid*16+11];
    call MOD_2;
    multipop(R1,R2);

    breakpoint;
    return;
endif;

//exit process
if(funcNum==3) then
    alias pid R2;
    multipush(R1,R2);
    R1=4;
    R2=pid;
    call MOD_1;

    R1=2;
    R2=pid;
    call MOD_1;
    multipop(R1,R2);
    [PROCESS_TABLE+pid*16+4]=TERMINATED;

    breakpoint;
    return;
endif;

//free pageTable
if(funcNum==4) then 
    alias pid R2;
    alias pageTable R3;
    pageTable=PAGE_TABLE_BASE+pid*20;
    [pageTable]=-1;
    [pageTable+1]="0000";
    [pageTable+2]=-1;
    [pageTable+3]="0000";

    alias iter R4;
    iter=4;
    while(iter<20) do 
        if([pageTable+iter]!=-1) then
            multipush(R1,R2,R3,R4,R5);
            R1=2;
            R2=[pageTable+iter];
            call MOD_2;
            multipop(R1,R2,R3,R4,R5);

            [pageTable+iter]=-1;
            [pageTable+iter+1]="0000";
        endif;
        iter=iter+2;
    endwhile;

    //release blocks from disk of heap and stack
    iter = 2;
    while (iter < 10) do
        if ([DISK_MAP_TABLE +pid* 10 + iter] != -1) then
            if (iter < 4 || iter > 7) then
                multipush(R1, R2, R3, R4);

                R1 = 4;
                R3 = pid;
                R2 = [DISK_MAP_TABLE +pid*10 + iter];

                call MOD_2;

                multipop(R1, R2, R3, R4);
            endif;
            [DISK_MAP_TABLE + pid* 10 + iter] = -1;
        endif;
        iter = iter + 1;
    endwhile;

    breakpoint;
    return;
endif;