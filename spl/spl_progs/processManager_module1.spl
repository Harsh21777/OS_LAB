alias funcNum R1;


if(funcNum==2) then
    alias pid R2;
    multipush(R1,R2);
    R1=2;
    R2=[PROCESS_TABLE+pid*16+11];
    call MOD_2;
    multipop(R1,R2);

    return;
endif;

if(funcNum==3) then
    alias pid R2;
    multipush(R1,R2);
    R1=4;
    R2=pid;
    call MOD_1;

    R1=2;
    R2=pid;
    call MOD_1;
    multipop(R1,R2);
    [PROCESS_TABLE+pid*16+4]=TERMINATED;
    return;
endif;

if(funcNum==4) then 
    alias pid R2;
    alias pageTable R3;
    pageTable=PAGE_TABLE_BASE+pid*20;
    [pageTable]=-1;
    [pageTable+1]="0000";
    [pageTable+2]=-1;
    [pageTable+3]="0000";

    alias iter R4;
    iter=4;
    while(iter<20) do 
        alias mask R5;
        mask="0100";
        if([pageTable+iter]!=-1) then
            multipush(R1,R2,R3,R4,R5);
            R1=2;
            R2=[pageTable+iter];
            call MOD_2;
            multipop(R1,R2,R3,R4,R5);

            [pageTable+iter]=-1;
            [pageTable+iter+1]="0000";
        endif;
        iter=iter+2;
    endwhile;
    breakpoint;
    return;
endif;