alias funcNum R1;

//get pcb entry
if(funcNum==GET_PCB_ENTRY) then
    alias iterPID R2;
    iterPID=0;
    while(iterPID<MAX_PROC_NUM) do
        if([PROCESS_TABLE+16*iterPID+4]==TERMINATED) then
            [PROCESS_TABLE+16*iterPID+1]=iterPID;
            [PROCESS_TABLE+16*iterPID+4]=ALLOCATED;
            [PROCESS_TABLE+16*iterPID+14]=PAGE_TABLE_BASE+20*iterPID;
            [PROCESS_TABLE+16*iterPID+15]=10;

            R0=iterPID;
            return;
        endif;
        iterPID=iterPID+1;
    endwhile;

    R0=-1;
    return;
endif;

//free userAreaPage
if(funcNum==FREE_USER_AREA_PAGE) then
    alias pid R2;

    alias iter R3;
    iter=0;
    while(iter<16) do
        //release semaphores
        if([[PROCESS_TABLE+pid*16+11]*512+RESOURCE_TABLE_OFFSET+iter]==SEMAPHORE) then
            multipush(R1,R2,R3);

            R1=RELEASE_SEMAPHORE;
            R2=[[PROCESS_TABLE+pid*16+11]*512+496+iter+1];
            R3=pid;
            call MOD_0;//resource manager

            multipop(R1,R2,R3);           
        endif;

        //release files
        if([[PROCESS_TABLE+pid*16+11]*512+RESOURCE_TABLE_OFFSET+iter]==FILE) then
            multipush(R1,R2,R3);

            R1=CLOSE;
            R2=[[PROCESS_TABLE+pid*16+11]*512+496+iter+1];
            call MOD_3;//file manager

            multipop(R1,R2,R3);           
        endif;

        iter=iter+2;
    endwhile;

    multipush(R1,R2,R3);
    R1=RELEASE_PAGE;
    R2=[PROCESS_TABLE+pid*16+11];
    call MOD_2;
    multipop(R1,R2,R3);

    breakpoint;
    return;
endif;

//exit process
if(funcNum==EXIT_PROCESS) then
    alias pid R2;
    multipush(R1,R2);
    R1=FREE_PAGE_TABLE;
    R2=pid;
    call MOD_1;
    multipop(R1,R2);

    multipush(R1,R2);
    R1=FREE_USER_AREA_PAGE;
    R2=pid;
    call MOD_1;
    multipop(R1,R2);
    

    if([PROCESS_TABLE+16*pid+9]!=INT_EXEC) then
        alias iter R3;
        iter=0;
        while(iter<MAX_PROC_NUM) do
            //change the state to READY for the processes whose state is tuple (WAIT_PROCESS, current PID)
            if(([PROCESS_TABLE+16*iter+4]==WAIT_PROCESS)&&([PROCESS_TABLE+16*iter+5]==pid)) then
                [PROCESS_TABLE+16*iter+4]=READY;
            endif;

            //if the PPID of a process is PID of current process, then invalidate PPID field to -1.
            if([PROCESS_TABLE+16*iter+2]==pid) then
                [PROCESS_TABLE+16*iter+2]=-1;
            endif;

            iter=iter+1;
        endwhile;
    endif;

    [PROCESS_TABLE+pid*16+4]=TERMINATED;

    breakpoint;
    return;
endif;

//free pageTable
if(funcNum==FREE_PAGE_TABLE) then 
    alias pid R2;
    alias pageTable R3;
    pageTable=PAGE_TABLE_BASE+pid*20;
    [pageTable]=-1;
    [pageTable+1]="0000";
    [pageTable+2]=-1;
    [pageTable+3]="0000";

    alias iter R4;
    iter=4;
    while(iter<20) do 
        if([pageTable+iter]!=-1) then
            multipush(R1,R2,R3,R4,R5);
            R1=RELEASE_PAGE;
            R2=[pageTable+iter];
            call MOD_2;
            multipop(R1,R2,R3,R4,R5);

            [pageTable+iter]=-1;
            [pageTable+iter+1]="0000";
        endif;
        iter=iter+2;
    endwhile;

    //release blocks from disk of heap and stack
    iter = 2;
    while (iter < 10) do
        if ([DISK_MAP_TABLE +pid* 10 + iter] != -1) then
            if (iter < 4 || iter > 7) then
                multipush(R1, R2, R3, R4);

                R1 = RELEASE_BLOCK;
                R3 = pid;
                R2 = [DISK_MAP_TABLE +pid*10 + iter];

                call MOD_2;

                multipop(R1, R2, R3, R4);
            endif;
            [DISK_MAP_TABLE + pid* 10 + iter] = -1;
        endif;
        iter = iter + 1;
    endwhile;

    breakpoint;
    return;
endif;