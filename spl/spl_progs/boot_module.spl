//load disk free list
load(61,2);

// loading ExHanding code from disk 15-16 to mem 2-3
loadi(2,15);
loadi(3,16);

//loading timer interrupt routine 
loadi(4,17);
loadi(5,18);

//load disk interrupt
loadi(6,19);
loadi(7,20);

//load console interrupt
loadi(8,21);
loadi(9,22);

//load INT6
loadi(14,27);
loadi(15,28);

//load INT7 from disk to mem
loadi(16,29);
loadi(17,30);

//load INT8
loadi(18,31);
loadi(19,32);

//load INT9
loadi(20,33);
loadi(21,34);

// loading INT 10 code from disk 35-36 to mem 22-23
loadi(22,35);
loadi(23,36);

//load INT11
loadi(24,37);
loadi(25,38);

//load INT13
loadi(28,41);
loadi(29,42);

//load INT14
loadi(30,43);
loadi(31,44);

//load INT15
loadi(32,45);
loadi(33,46);

//load module 0 (resource manager)
loadi(40,53);
loadi(41,54);

//load module 1 (process manager)
loadi(42,55);
loadi(43,56);

//load module 2 (memory manager)
loadi(44,57);
loadi(45,58);

//load module 4 (device manager)
loadi(48,61);
loadi(49,62);

//load module 5 (scheduler)
loadi(50,63);
loadi(51,64);

//load inode table
loadi(59,3);
loadi(60,4);

// load library code
loadi(63,13);
loadi(64,14);

// loading INIT program from disk 7-8 to mem 65-66
loadi(65,7);
loadi(66,8);

//FOR GCD(INIT) PROCESS

// initializing PTBR to default - 29696+20(as pid of init=1)
PTBR = PAGE_TABLE_BASE+20;

// INIT Program needs 3 pages of memory
PTLR = 10;

// library
[PTBR+0] =  63;
[PTBR+1] = "0100";	
[PTBR+2] = 64;
[PTBR+3] = "0100";

//heap
[PTBR+4] = 78;
[PTBR+5] = "0110";	
[PTBR+6] = 79;
[PTBR+7] = "0110";	

//code
[PTBR+8] = 65;
[PTBR+9] = "0100";	
[PTBR+10] = 66;
[PTBR+11] = "0100";	
[PTBR+12] = -1;
[PTBR+13] = "0000";	
[PTBR+14] = -1;
[PTBR+15] = "0000";	

//stack
[PTBR+16] = 76;
[PTBR+17] = "0110";	
[PTBR+18] = 77;
[PTBR+19] = "0110";	

[76*512] = [65*512+1];	// IP to 2nd word in header when loaded from code which is in EXEC format


//user Area page for init process
[PROCESS_TABLE +1*16+ 11] = 80;
//setting PID for 1st process 
[PROCESS_TABLE+1*16+1]=1;
//setinng state
[PROCESS_TABLE+1*16+4]=CREATED;
//seting UPTR field 
[PROCESS_TABLE +1*16+ 13] = 8*512;
//seting KPTR field 
[PROCESS_TABLE +1*16+ 12] = 0;
//seting PTBR and PTLR field 
[PROCESS_TABLE +1*16+ 14] = PAGE_TABLE_BASE+20;
[PROCESS_TABLE +1*16+ 15] = 10;

alias iter R0;
iter=2;
while(iter<MAX_PROC_NUM) do
    [PROCESS_TABLE+iter*16+4]=TERMINATED;
    iter=iter+1;
endwhile;

//seting MEMORY_FREE_LIST
iter=0;
while(iter<=75) do
    [MEMORY_FREE_LIST+iter]=1;
    iter=iter+1;
endwhile;

while(iter<NUM_MEM_PAGES) do
    [MEMORY_FREE_LIST+iter]=0;
    iter=iter+1;
endwhile;

//setting bit for initally alloacated pages
iter=76;
while(iter<=82) do
    [MEMORY_FREE_LIST+iter]=1;
    iter=iter+1;
endwhile;

// per-process resource table for init
iter = 1;
while (iter < 9) do
    [([PROCESS_TABLE + 16 + 11] + 1) * 512 - 2 * iter] = -1;
    iter = iter + 1;
endwhile;

//initialize per-process diskMapTable
iter=0;
while(iter<10) do
    [DISK_MAP_TABLE+1*10+iter]=-1;
    iter=iter+1;
endwhile;

[DISK_MAP_TABLE+1*10+4]=7;
[DISK_MAP_TABLE+1*10+5]=8;

//initialise SEMAPHORE_TABLE
iter=0;
while(iter<32) do 
    [SEMAPHORE_TABLE+(iter*4)]=-1;
    [SEMAPHORE_TABLE+(iter*4)+1]=0;

    iter=iter+1;
endwhile;


//initialize the STATUS field in the Terminal Status table as 0.
[TERMINAL_STATUS_TABLE]=0;

//Initialize the STATUS field in the Disk Status Table
[DISK_STATUS_TABLE]=0;

//initialize the fields WAIT_MEM_COUNT to 0 and MEM_FREE_COUNT to number of free pages
[SYSTEM_STATUS_TABLE+3]=0;
[SYSTEM_STATUS_TABLE+2]=45;
[SYSTEM_STATUS_TABLE+1]=0;


//for assg 22 q2&q3
//allocating unused memory in root file i.e. page no. 62 from 32224-32255
//memory use ->32224
[32224]=0;
//no. of disk access->32225
[32225]=0;
//no. of context switch->32226
[32226]=0;
//no. of switches to KERNEL->32227
[32227]=0;


return;