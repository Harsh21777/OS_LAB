breakpoint;

alias currentPID R5;
currentPID=[SYSTEM_STATUS_TABLE+CORE*5+1];

//saving userStack and setting kernelStack
alias userSP R1;
userSP=SP;

[PROCESS_TABLE+currentPID*16+13]=SP;
SP=[PROCESS_TABLE+currentPID*16+11]*512-1;

multipush(R1,R5);
R1 = ACQUIRE_KERN_LOCK;
call MOD_8;//access control
multipop(R1,R5);

//change MODE flg
[PROCESS_TABLE+currentPID*16+9]=INT_LOGIN;

//Login process has PID = 1
if(currentPID!=1) then
    [([PTBR + 2*((userSP-1)/512)]*512)+((userSP-1)%512)]=-2;
    goto endOfCode;
endif;

alias userName R2;
alias password R3;
R2=[([PTBR + 2*((userSP-4)/512)]*512)+((userSP-4)%512)];
R3=[([PTBR + 2*((userSP-3)/512)]*512)+((userSP-3)%512)];

alias userId R4;
userId=1;
while(userId<MAX_USER_NUM) do 
    if([USER_TABLE+userId*2+0]==userName) then
        break;
    endif;
    userId=userId+1;
endwhile;

//entry does not exist
if(userId==MAX_USER_NUM) then
    [([PTBR + 2*((userSP-1)/512)]*512)+((userSP-1)%512)]=-1;
    goto endOfCode;
endif;

//Encrypt the password
encrypt password;

//encypted input password does not match the ENCRYPTED PASSWORD field is USER_TABLE
if(password!=[USER_TABLE+userId*2+1]) then
    [([PTBR + 2*((userSP-1)/512)]*512)+((userSP-1)%512)]=-1;
    goto endOfCode;
endif;

//process table entry for the shell process
[PROCESS_TABLE+SHELL_PROCESS*16+4]=CREATED;
[PROCESS_TABLE+SHELL_PROCESS*16+3]=userId;

//Set the state of the current process
[PROCESS_TABLE+currentPID*16+4]=WAIT_PROCESS;
[PROCESS_TABLE+currentPID*16+5]=SHELL_PROCESS;

//set the CURRENT_USER_ID as that of the user who is logging in
[SYSTEM_STATUS_TABLE+0]=userId;

multipush(R1,R2,R3,R4,R5);
R1 = RELEASE_LOCK;
R2 = KERN_LOCK;
call MOD_8;
multipop(R1,R2,R3,R4,R5);

multipush(R1,R2,R3,R4,R5);

call MOD_5;//scheduler

multipop(R1,R2,R3,R4,R5);

multipush(R1,R2,R3,R4,R5);
R1 = ACQUIRE_KERN_LOCK;
call MOD_8;//access control
multipop(R1,R2,R3,R4,R5);

[([PTBR + 2*((userSP-1)/512)]*512)+((userSP-1)%512)]=0;
goto endOfCode;

endOfCode:
    multipush(R1,R5);
    R1 = RELEASE_LOCK;
    R2 = KERN_LOCK;
    call MOD_8;
    multipop(R1,R5);

    [PROCESS_TABLE+currentPID*16+9]=0;
    SP=userSP;

    breakpoint;
    ireturn;