[PROCESS_TABLE+[SYSTEM_STATUS_TABLE+CORE*5+1]*16+13]=SP;

SP=[PROCESS_TABLE+[SYSTEM_STATUS_TABLE+CORE*5+1]*16+11]*512-1;

backup;

alias currentPID R0;
currentPID=[TERMINAL_STATUS_TABLE+1];

[PROCESS_TABLE+currentPID*16+8]=P0;

//RELEASE TERMINAL
multipush(R0,R1);

R1=RELEASE_TERMINAL;
R2=currentPID;

call MOD_0;

multipop(R0,R1);

restore;

SP = [PROCESS_TABLE + 16 * [SYSTEM_STATUS_TABLE+CORE*5 + 1] + 13];

breakpoint;
ireturn;


