//setting UPTR of current process in process table of current process
[PROCESS_TABLE + ( [SYSTEM_STATUS_TABLE +CORE*5+ 1] * 16) + 13] = SP;

// Setting SP to UArea Page number * 512 - 1
SP = [PROCESS_TABLE + ([SYSTEM_STATUS_TABLE +CORE*5+ 1] * 16) + 11] * 512 - 1;

breakpoint;
//backup reg context of current going process
backup;

R1 = ACQUIRE_KERN_LOCK;
call MOD_8;//access control

if(CORE==PRIMARY_CORE) then
    if([SYSTEM_STATUS_TABLE+5]!=0) then 
        //swapping is initiated 
        if([SYSTEM_STATUS_TABLE+CORE*5+1]==SWAPPER_DAEMON) then

            R1=[SYSTEM_STATUS_TABLE+5];  
            R2=[SYSTEM_STATUS_TABLE+CORE*5+1];      
            call MOD_6; //pager 

        endif;

    else
        //Swapping is not on now.  
        //Check whether it must be initiated 
        if([SYSTEM_STATUS_TABLE+2]<MEM_LOW) then
            [SYSTEM_STATUS_TABLE+5]=SWAP_OUT;
        else
            //there are swapped out processes
            if([SYSTEM_STATUS_TABLE+4]>0) then
                alias iterPID R1;
                iterPID=3;
                while(iterPID<MAX_PROC_NUM-2) do
                    //swap flage is 1
                    if([PROCESS_TABLE+iterPID*16+6]==1) then

                        if(([PROCESS_TABLE+iterPID*16+0]>MAX_TICK)||([SYSTEM_STATUS_TABLE+2]>MEM_HIGH)) then
                            [SYSTEM_STATUS_TABLE+5]=SWAP_IN;
                            break;
                        endif;

                    endif;
                    iterPID=iterPID+1;
                endwhile;
            endif;

        endif;
    endif;

endif;
[PROCESS_TABLE+[SYSTEM_STATUS_TABLE+CORE*5+1]*16+4]=READY;
breakpoint;

//Loop through the process table entires and increment the TICK field of each process.
alias iterPID R1;
iterPID=0;
while(iterPID<MAX_PROC_NUM) do
    if([PROCESS_TABLE + iterPID*16 + 4] != TERMINATED) then
		[PROCESS_TABLE + iterPID*16] = [PROCESS_TABLE + iterPID*16] + 1;
	endif;
    iterPID=iterPID+1;
endwhile;

R1 = RELEASE_LOCK;
R2 = KERN_LOCK;
call MOD_8;

call MOD_5;

restore;
breakpoint;

[PROCESS_TABLE + 16 * [SYSTEM_STATUS_TABLE +CORE*5+ 1] + 12] = 0;
SP = [PROCESS_TABLE + 16 * [SYSTEM_STATUS_TABLE +CORE*5+ 1] + 13];
[PROCESS_TABLE + 16 * [SYSTEM_STATUS_TABLE +CORE*5+ 1] + 9] = 0;

ireturn;