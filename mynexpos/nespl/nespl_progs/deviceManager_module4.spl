alias funcNum R1;
alias currentPID R2;

//disk load
if(funcNum==DISK_LOAD) then
    
    alias pageNum R3;
    alias blkNum R4;
    multipush(R1,R2,R3,R4);

    R1=ACQUIRE_DISK;
    R2=currentPID;
    call MOD_0;

    multipop(R1,R2,R3,R4);

    [DISK_STATUS_TABLE]=1;
    [DISK_STATUS_TABLE+1]=0;
    [DISK_STATUS_TABLE+2]=pageNum;
    [DISK_STATUS_TABLE+3]=blkNum;
    [DISK_STATUS_TABLE+4]=currentPID;
    load(pageNum,blkNum);
    [PROCESS_TABLE+currentPID*16+4]=WAIT_DISK;
    multipush(R1,R2,R3,R4);
    R1 = RELEASE_LOCK;
    R2 = KERN_LOCK;
    call MOD_8;

    call MOD_5;

    R1= ACQUIRE_KERN_LOCK;
    call MOD_8;

    multipop(R1,R2,R3,R4);

    return;

endif;

//disk Store
if(funcNum==DISK_STORE) then
    
    alias pageNum R3;
    alias blkNum R4;
    multipush(R1,R2,R3,R4);

    R1=ACQUIRE_DISK;
    R2=currentPID;
    call MOD_0;

    multipop(R1,R2,R3,R4);

    [DISK_STATUS_TABLE]=1;
    [DISK_STATUS_TABLE+1]=1;
    [DISK_STATUS_TABLE+2]=pageNum;
    [DISK_STATUS_TABLE+3]=blkNum;
    [DISK_STATUS_TABLE+4]=currentPID;
    store(pageNum,blkNum);
    [PROCESS_TABLE+currentPID*16+4]=WAIT_DISK;

    multipush(R1,R2,R3,R4);
    
    R1 = RELEASE_LOCK;
    R2 = KERN_LOCK;
    call MOD_8;

    call MOD_5;

    R1= ACQUIRE_KERN_LOCK;
    call MOD_8;

    multipop(R1,R2,R3,R4);

    return;
endif;

//terminal write
if(funcNum==TERMINAL_WRITE) then 
    alias word R3;
    //AQUIRE TERMINAL

    //Push all the registers used till now in this module
    multipush(R1,R2,R3);
    //Store the function number 8 in register R1 and PID in R2
    funcNum=ACQUIRE_TERMINAL;
    currentPID=currentPID;

    call MOD_0;

    multipop(R1,R2,R3);

    print word;

    //RELEASE TERMINAL
    multipush(R1,R2,R3);
    funcNum=RELEASE_TERMINAL;
    currentPID=currentPID;

    call MOD_0;

    multipop(R1,R2,R3);

    return;

endif;

//terminal read
if(funcNum==TERMINAL_READ) then
    alias wordPutAddr R3;
    //AQUIRE TERMINAL

    //Push all the registers used till now in this module
    multipush(R1,R2,R3);
    //Store the function number 8 in register R1 and PID in R2
    R1=ACQUIRE_TERMINAL;
    R2=currentPID;

    call MOD_0;

    multipop(R1,R2,R3);

    read;

    [PROCESS_TABLE+currentPID*16+4]=WAIT_TERMINAL;

    //INVOKE Context Switch
    multipush(R1,R2,R3);

    R1 = RELEASE_LOCK;
    R2 = KERN_LOCK;
    call MOD_8;

    call MOD_5;

    R1= ACQUIRE_KERN_LOCK;
    call MOD_8;

    multipop(R1,R2,R3); 

    alias offset R4;
    alias pageNum R5;
    alias physicalAddr R6;
    pageNum=[PTBR + 2*(wordPutAddr/512)];
    offset=wordPutAddr%512;
    physicalAddr=pageNum*512+offset;
    //Store the value present in input buffer field of process table to physicalAddr
    [physicalAddr]=[PROCESS_TABLE+currentPID*16+8];

    return;

endif;

breakpoint;
return;