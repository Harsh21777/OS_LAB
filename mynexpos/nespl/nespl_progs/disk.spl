breakpoint;
[PROCESS_TABLE+[SYSTEM_STATUS_TABLE+CORE*5+1]*16+13]=SP;

SP=[PROCESS_TABLE+[SYSTEM_STATUS_TABLE+CORE*5+1]*16+11]*512-1;

backup;

[DISK_STATUS_TABLE]=0;

alias iter R0;
iter=1;
while(iter<MAX_PROC_NUM) do
    if([PROCESS_TABLE+iter*16+4]==WAIT_DISK) then   
        [PROCESS_TABLE+iter*16+4]=READY;
    endif;
    iter=iter+1;
endwhile;


restore;

SP = [PROCESS_TABLE + 16 * [SYSTEM_STATUS_TABLE+CORE*5+1] + 13];

breakpoint;
ireturn;