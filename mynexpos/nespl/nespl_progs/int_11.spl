
alias currentPID R4;
currentPID=[SYSTEM_STATUS_TABLE+CORE*5+1];
//saving userStack and setting kernelStack
alias userSP R1;
userSP=SP;

[PROCESS_TABLE+currentPID*16+13]=SP;
SP=[PROCESS_TABLE+currentPID*16+11]*512-1;

multipush(R1,R4);
R1 = ACQUIRE_KERN_LOCK;
call MOD_8;//access control
multipop(R1,R4);


alias sysCallNo R2;
sysCallNo=[([PTBR + 2*((userSP-5)/512)]*512)+((userSP-5)%512)];

//WAIT syscall
if(sysCallNo==INT_WAIT) then
    //change MODE flg
    [PROCESS_TABLE+currentPID*16+9]=INT_WAIT;

    alias otherPid R3;
    otherPid=[([PTBR + 2*((userSP-4)/512)]*512)+((userSP-4)%512)];

    //A process should not wait for itself or a TERMINATED process. The argument PID should be in valid range 
    if((otherPid==currentPID)||([PROCESS_TABLE+16*otherPid+4]==TERMINATED)||(otherPid>15)||(otherPid<0)) then
        [([PTBR + 2*((userSP-1)/512)]*512)+((userSP-1)%512)]=-1;
        goto endOfCode;
    endif;

    //Change the state of the current process
    [PROCESS_TABLE+16*currentPID+4]=WAIT_PROCESS;
    [PROCESS_TABLE+16*currentPID+5]=otherPid;

    multipush(R1,R2,R3,R4);
    R1 = RELEASE_LOCK;
    R2 = KERN_LOCK;
    call MOD_8;
    multipop(R1,R2,R3,R4);


    multipush(R1,R2,R3,R4);

    call MOD_5;

    multipop(R1,R2,R3,R4);

    [([PTBR + 2*((userSP-1)/512)]*512)+((userSP-1)%512)]=0;
    [PROCESS_TABLE+currentPID*16+9]=0;
    SP=userSP;

    breakpoint;
    ireturn;
endif;

//SIGNAL syscall
if(sysCallNo==INT_SIGNAL) then
    //change MODE flg
    [PROCESS_TABLE+currentPID*16+9]=INT_SIGNAL;

    alias iter R3;
    iter=0;
    while(iter<MAX_PROC_NUM) do
        if(([PROCESS_TABLE+16*iter+4]==WAIT_PROCESS)&&([PROCESS_TABLE+16*iter+5]==currentPID)) then
            [PROCESS_TABLE+16*iter+4]=READY;
        endif;
        iter=iter+1;
    endwhile;

    [([PTBR + 2*((userSP-1)/512)]*512)+((userSP-1)%512)]=0;
    goto endOfCode;
endif;

//get pid
if(sysCallNo==INT_GETPID) then
    //change MODE flg
    [PROCESS_TABLE+currentPID*16+9]=INT_GETPID;

    //set pid as return val
    [([PTBR + 2*((userSP-1)/512)]*512)+((userSP-1)%512)]=[PROCESS_TABLE+16*currentPID+1];

    goto endOfCode;
endif;

if(sysCallNo==INT_GETPPID) then
    //change MODE flg
    [PROCESS_TABLE+currentPID*16+9]=INT_GETPPID;

    //set pid as return val
    [([PTBR + 2*((userSP-1)/512)]*512)+((userSP-1)%512)]=[PROCESS_TABLE+16*currentPID+2];
    goto endOfCode;
endif;

endOfCode:
    multipush(R1,R4);
    R1 = RELEASE_LOCK;
    R2 = KERN_LOCK;
    call MOD_8;
    multipop(R1,R4);

    [PROCESS_TABLE+currentPID*16+9]=0;
    SP=userSP;

    breakpoint;
    ireturn;