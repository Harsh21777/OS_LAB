//incr no. switches to KERNEL
[32227]=[32227]+1;

breakpoint;
[PROCESS_TABLE+[SYSTEM_STATUS_TABLE+CORE*5+1]*16+9]=-1;

[PROCESS_TABLE+[SYSTEM_STATUS_TABLE+CORE*5+1]*16+13]=SP;
SP=[PROCESS_TABLE+[SYSTEM_STATUS_TABLE+CORE*5+1]*16+11]*512-1;

backup;
multipush(EIP);

R1 = ACQUIRE_KERN_LOCK;
call MOD_8;

if(([PROCESS_TABLE + [SYSTEM_STATUS_TABLE+CORE*5+1] * 16 + 13] == (PTLR * 512 - 1))||(EC!=0))then
    if([PROCESS_TABLE + [SYSTEM_STATUS_TABLE+CORE*5+1] * 16 + 13] == (PTLR * 512 - 1))then
        print "User Stack Full";
    endif;

    if(EC!=0) then
        if(EC==1) then
            print "II";
        endif;

        if(EC==2) then
            print "IMA";
        endif;

        if(EC==3) then
            print "AE";
        endif;
    endif;
    
    R1 = EXIT_PROCESS;
    R2 = [SYSTEM_STATUS_TABLE+CORE*5+1];
    call MOD_1;

    R1 = RELEASE_LOCK;
    R2 = KERN_LOCK;
    call MOD_8;

    call MOD_5;

else

    if((EPN>3)&&(EPN<8)) then
        alias codeBlkNum R2;
        codeBlkNum=[DISK_MAP_TABLE+[SYSTEM_STATUS_TABLE+CORE*5+1]*10+EPN];//2,3,4,5 are for code blk in DISK_MAP_TABLE
        alias epnCopy R3;
        epnCopy=EPN;

        multipush(R1,R2,R3,EPN);

        R1=GET_CODE_PAGE;
        R2=codeBlkNum;
        
        call MOD_2;//get code page

        multipop(R1,R2,R3,EPN);
        [PAGE_TABLE_BASE+[SYSTEM_STATUS_TABLE+CORE*5+1]*20+2*epnCopy]=R0;
        [PAGE_TABLE_BASE+[SYSTEM_STATUS_TABLE+CORE*5+1]*20+2*epnCopy+1]="1100";
    endif;

    if((EPN>1)&&(EPN<4)) then

        R1=GET_FREE_PAGE;
        call MOD_2;
        [PAGE_TABLE_BASE+[SYSTEM_STATUS_TABLE+CORE*5+1]*20+4]=R0;
        [PAGE_TABLE_BASE+[SYSTEM_STATUS_TABLE+CORE*5+1]*20+5]="1110";

        R1=GET_FREE_PAGE;
        call MOD_2;
        [PAGE_TABLE_BASE+[SYSTEM_STATUS_TABLE+CORE*5+1]*20+6]=R0;
        [PAGE_TABLE_BASE+[SYSTEM_STATUS_TABLE+CORE*5+1]*20+7]="1110";

    endif;

    [PROCESS_TABLE+[SYSTEM_STATUS_TABLE+CORE*5+1]*16+9]=0;

    R1 = RELEASE_LOCK;
    R2 = KERN_LOCK;
    call MOD_8;

    multipop(EIP);

    restore;

    SP=[PROCESS_TABLE+[SYSTEM_STATUS_TABLE+CORE*5+1]*16+13];
    SP=SP+1;

    [[PTBR+(SP/512)*2]*512+(SP%512)]=EIP;
    
    breakpoint;
    ireturn;


endif;




